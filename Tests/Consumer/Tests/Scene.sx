use GFX.Application

class GlobalState { var value:int }
struct LocalStep { let value:int }

func advance(global:&GlobalState, step:@LocalStep) {
    global.value += step.value
}

test "consume the merged Application module through its extension package" {
    var global = GlobalState(value:40)
    var application = Application()..add_resource(global)
    var scene = Application.Scene(application)
        ..add_resource(LocalStep(value:2))
        ..add_system(Application.Schedule.update, advance)

    scene.mount()
    scene.run_schedule(Application.Schedule.update)
    scene.unmount()
    assert(global.value == 42)
}
