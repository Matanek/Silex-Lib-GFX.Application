// Package-level lifecycle and isolation coverage for Application.Scene.
use GFX.Application
use GFX.ECS

class Trace {
    var steps:int[]
    var local_drops:int
    var global_drops:int

    init() {
        self.steps = []
        self.local_drops = 0
        self.global_drops = 0
    }
}

class GlobalCounter { var value:int }
class QueryProbe {
    var count:int
    var total:int
}
struct ScopedStep { let value:int }
struct Position { let value:int }

struct OwnedResource {
    let scene_owned:bool
    var trace:Trace

    drop {
        if self.scene_owned {
            self.trace.local_drops++
        } else {
            self.trace.global_drops++
        }
    }
}

func initialize(trace:&Trace) { trace.steps.append(1) }
func startup(trace:&Trace) { trace.steps.append(2) }

func update(
    trace:&Trace,
    global:&GlobalCounter,
    step:@ScopedStep,
    commands:&ECS.Commands
) {
    assert(step.value == 2)
    global.value += step.value
    trace.steps.append(3)
    commands.spawn(ECS.EntityRecipe()..with(Position(value:global.value)))
}

func shutdown(trace:&Trace) { trace.steps.append(4) }
func finalize(trace:&Trace) { trace.steps.append(5) }

func spawn_distinct(value:@ScopedStep, world:&ECS.World) {
    world.spawn(ECS.EntityRecipe()..with(Position(value:value.value)))
}

func inspect_distinct(
    expected:@ScopedStep,
    query:ECS.Query<(ECS.Entity, @Position)>,
    probe:&QueryProbe
) {
    for (entity, position) in query {
        assert(entity.is_valid())
        assert(position.value == expected.value)
        probe.count++
        probe.total += position.value
    }
}

test "mount a typed scene with local ECS and scoped application resources" {
    var trace = Trace()
    var global = GlobalCounter(value:40)
    var application = Application()
        ..add_resource(global)
        ..add_resource(ScopedStep(value:100))
        ..add_resource(OwnedResource(scene_owned:false, trace:trace))
    var scene = Application.Scene(application)
        ..add_resource(trace)
        ..add_resource(ScopedStep(value:2))
        ..add_resource(OwnedResource(scene_owned:true, trace:trace))
        ..add_system(Application.Schedule.initialize, initialize)
        ..add_system(Application.Schedule.startup, startup)
        ..add_system(Application.Schedule.update, update)
        ..add_system(Application.Schedule.shutdown, shutdown)
        ..add_system(Application.Schedule.finalize, finalize)

    assert(!scene.is_mounted())
    assert(trace.steps.is_empty())
    scene.mount()
    assert(scene.is_mounted())
    scene.run_schedule(Application.Schedule.update)
    scene.run_schedule(Application.Schedule.post_update)

    if true {
        var resources = scene.resources()
        let world:@ECS.World = resources.get<ECS.World>()
        let entities = world.entities()
        assert(entities.count() == 1)
        assert(world.get<Position>(entities[0]).value == 42)
    }
    assert(global.value == 42)

    scene.unmount()
    assert(scene.is_finalized())
    assert(trace.steps.count() == 5)
    for index in 0...5 { assert(trace.steps[index] == index + 1) }
    assert(trace.local_drops == 1)
    assert(trace.global_drops == 0)
    assert(application.resources().has<OwnedResource>())
}

test "isolate identical component and resource types between scenes" {
    var application = Application()
    var first_probe = QueryProbe(count:0, total:0)
    var second_probe = QueryProbe(count:0, total:0)
    var first = Application.Scene(application)
        ..add_resource(ScopedStep(value:11))
        ..add_resource(first_probe)
        ..add_system(Application.Schedule.startup, spawn_distinct)
        ..add_system(Application.Schedule.update, inspect_distinct)
    var second = Application.Scene(application)
        ..add_resource(ScopedStep(value:22))
        ..add_resource(second_probe)
        ..add_system(Application.Schedule.startup, spawn_distinct)
        ..add_system(Application.Schedule.update, inspect_distinct)

    first.mount()
    second.mount()
    first.run_schedule(Application.Schedule.update)
    second.run_schedule(Application.Schedule.update)

    if true {
        var first_resources = first.resources()
        var second_resources = second.resources()
        let first_world:@ECS.World = first_resources.get<ECS.World>()
        let second_world:@ECS.World = second_resources.get<ECS.World>()
        let first_entities = first_world.entities()
        let second_entities = second_world.entities()
        assert(first_entities.count() == 1)
        assert(second_entities.count() == 1)
        assert(first_world.get<Position>(first_entities[0]).value == 11)
        assert(second_world.get<Position>(second_entities[0]).value == 22)
    }
    assert(first_probe.count == 1)
    assert(first_probe.total == 11)
    assert(second_probe.count == 1)
    assert(second_probe.total == 22)
    first.unmount()
    second.unmount()
}
