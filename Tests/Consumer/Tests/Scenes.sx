use GFX.Application
use GFX.ECS

class TransitionTrace {
    var steps:int[]

    init() {
        self.steps = []
    }
}

struct TransitionEntity { let scene:int }

func first_initialize(trace:&TransitionTrace) { trace.steps.append(1) }
func first_startup(trace:&TransitionTrace) { trace.steps.append(2) }

func first_update(
    scenes:&Application.Scenes,
    trace:&TransitionTrace,
    commands:&ECS.Commands
) {
    trace.steps.append(3)
    commands.spawn(ECS.EntityRecipe()..with(TransitionEntity(scene:1)))
    scenes.request(scenes.create()
        ..add_system(Application.Schedule.initialize, second_initialize)
        ..add_system(Application.Schedule.startup, second_startup)
        ..add_system(Application.Schedule.update, second_update)
        ..add_system(Application.Schedule.shutdown, second_shutdown)
        ..add_system(Application.Schedule.finalize, second_finalize))
}

func first_shutdown(
    trace:&TransitionTrace,
    entities:ECS.Query<(ECS.Entity, @TransitionEntity)>
) {
    var count = 0
    for (entity, marker) in entities {
        assert(entity.is_valid())
        assert(marker.scene == 1)
        count++
    }
    assert(count == 1)
    trace.steps.append(4)
}

func first_finalize(trace:&TransitionTrace, commands:&ECS.Commands) {
    trace.steps.append(5)
    // Finalize commands are flushed and then released with the outgoing World.
    commands.spawn(ECS.EntityRecipe()..with(TransitionEntity(scene:1)))
}

func second_initialize(
    trace:&TransitionTrace,
    entities:ECS.Query<(ECS.Entity, @TransitionEntity)>
) {
    assert(trace.steps.count() == 5)
    var count = 0
    for (entity, marker) in entities { count++ }
    assert(count == 0)
    trace.steps.append(6)
}

func second_startup(trace:&TransitionTrace) { trace.steps.append(7) }

func second_update(scenes:&Application.Scenes, trace:&TransitionTrace) {
    trace.steps.append(8)
    scenes.request(scenes.create()
        ..add_system(Application.Schedule.initialize, third_initialize)
        ..add_system(Application.Schedule.startup, third_startup)
        ..add_system(Application.Schedule.update, third_update)
        ..add_system(Application.Schedule.shutdown, third_shutdown)
        ..add_system(Application.Schedule.finalize, third_finalize))
}

func second_shutdown(trace:&TransitionTrace) { trace.steps.append(9) }
func second_finalize(trace:&TransitionTrace) { trace.steps.append(10) }

func third_initialize(
    trace:&TransitionTrace,
    entities:ECS.Query<(ECS.Entity, @TransitionEntity)>
) {
    assert(trace.steps.count() == 10)
    var count = 0
    for (entity, marker) in entities { count++ }
    assert(count == 0)
    trace.steps.append(11)
}

func third_startup(trace:&TransitionTrace) { trace.steps.append(12) }

func third_update(trace:&TransitionTrace, controller:&Application.Controller) {
    trace.steps.append(13)
    controller.stop()
}

func third_shutdown(trace:&TransitionTrace) { trace.steps.append(14) }
func third_finalize(trace:&TransitionTrace) { trace.steps.append(15) }

test "replace several scenes from injected systems at safe frame boundaries" {
    var trace = TransitionTrace()
    var application = Application()..add_resource(trace)
    var first = Application.Scene(application)
        ..add_system(Application.Schedule.initialize, first_initialize)
        ..add_system(Application.Schedule.startup, first_startup)
        ..add_system(Application.Schedule.update, first_update)
        ..add_system(Application.Schedule.shutdown, first_shutdown)
        ..add_system(Application.Schedule.finalize, first_finalize)
    var scenes = Application.Scenes(first)
    application.add_plugin(scenes)

    assert(application.run() == 0)
    assert(!scenes.has_active())
    assert(!scenes.has_pending())
    assert(first.is_finalized())
    assert(trace.steps.count() == 15)
    for index in 0...15 { assert(trace.steps[index] == index + 1) }
}

class ShutdownEdge {
    var replacement:Application.Scene?
    var outgoing_stops:int
    var outgoing_finalizes:int
    var incoming_starts:int

    init() {
        self.replacement = null
        self.outgoing_stops = 0
        self.outgoing_finalizes = 0
        self.incoming_starts = 0
    }
}

class ShutdownDependency { var alive:bool }

struct ShutdownDependencyPlugin:Application.Plugin {
    func id() str { return "GFX.Application.Tests.ShutdownDependency" }

    func build(application:&Application) {
        application.add_resource(ShutdownDependency(alive:true))
        application.add_system(Application.Schedule.shutdown, stop_dependency)
    }
}

func stop_dependency(dependency:&ShutdownDependency) {
    assert(dependency.alive)
    dependency.alive = false
}

func request_while_stopping(
    scenes:&Application.Scenes,
    edge:&ShutdownEdge,
    controller:&Application.Controller
) {
    var replacement = scenes.create()
        ..add_system(Application.Schedule.initialize, forbidden_incoming_start)
    edge.replacement = replacement
    scenes.request(replacement)
    controller.stop()
}

func outgoing_stop(edge:&ShutdownEdge, dependency:@ShutdownDependency) {
    assert(dependency.alive)
    edge.outgoing_stops++
}
func outgoing_finalize(edge:&ShutdownEdge) { edge.outgoing_finalizes++ }
func forbidden_incoming_start(edge:&ShutdownEdge) { edge.incoming_starts++ }

test "cancel a pending transition and finalize the active scene on application shutdown" {
    var edge = ShutdownEdge()
    var application = Application()..add_resource(edge)
    var outgoing = Application.Scene(application)
        ..add_system(Application.Schedule.update, request_while_stopping)
        ..add_system(Application.Schedule.shutdown, outgoing_stop)
        ..add_system(Application.Schedule.finalize, outgoing_finalize)
    var scenes = Application.Scenes(outgoing)
    application.add_plugin(ShutdownDependencyPlugin())
    application.add_plugin(scenes)

    assert(application.run() == 0)
    assert(outgoing.is_finalized())
    assert(!scenes.has_active())
    assert(!scenes.has_pending())
    assert(edge.outgoing_stops == 1)
    assert(edge.outgoing_finalizes == 1)
    assert(edge.incoming_starts == 0)
    assert(!application.resources().get<ShutdownDependency>().alive)
    if let replacement = edge.replacement {
        assert(!replacement.is_mounted())
        assert(!replacement.is_finalized())
    } else {
        panic("the shutdown edge did not retain its requested scene")
    }
}
